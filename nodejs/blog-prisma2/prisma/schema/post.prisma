model Post {
  id        String     @id @default(uuid())
  content   String     @db.VarChar(255)
  thumbnail String?    @db.Text
  isFeature Boolean    @default(false) @db.Boolean
  status    PostStatus @default(DRAFT)
  tags      String[]
  views     Int        @default(0)
  authorId  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  comments  Comment[]

  @@index([authorId])
  @@map("post")
}



enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}